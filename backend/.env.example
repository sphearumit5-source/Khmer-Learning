# Database Configuration
# លំនាំដើមប្រើ SQLite សម្រាប់ local development ងាយស្រួលដំណើរការភ្លាមៗ
DATABASE_URL=sqlite:///./khmer_learning.db

# សម្រាប់ PostgreSQL / Neon (ជ្រើសរើស) — app នឹងប្ដូរទៅ driver psycopg2 ដោយស្វ័យប្រវត្តិ
# DATABASE_URL=postgresql://user:password@host:5432/neondb?sslmode=require

# JWT Secret Key
SECRET_KEY=khmer-learning-super-secret-key-2026-cambodia-primary

# Google Gemini API Key — យក free key ពី https://aistudio.google.com/apikey
# បើទុកទទេ៖ គ្រូ AI នឹងឆ្លើយពីមេរៀនពិតដែលមានក្នុងកម្មវិធី (ជំនួស Demo Mode)
AI_API_KEY=
GEMINI_API_KEY=

# ឈ្មោះម៉ូដែល AI (gemini-1.5-flash ត្រូវបានបិទហើយ)
AI_MODEL=gemini-flash-latest
